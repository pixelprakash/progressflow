# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres (npm run dev:db starts one on :5433 without Docker; docker-compose uses :5432)
DATABASE_URL=postgresql://progressflow:progressflow@localhost:5433/progressflow?schema=public

# Object storage. Leave these commented out in development to store uploads on local disk.
# Set them for a deployed server (R2, S3, Supabase) or local MinIO from docker-compose.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=progressflow-media
# S3_ACCESS_KEY=progressflow
# S3_SECRET_KEY=progressflow
# S3_FORCE_PATH_STYLE=true

# Firebase Auth (teacher phone OTP) — leave blank until Phase 1
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Cloud Speech-to-Text — leave blank until Spike 3
GOOGLE_APPLICATION_CREDENTIALS=
SPEECH_MODEL=long

# Auth
JWT_SECRET=dev-only-change-me
